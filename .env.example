# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recallradar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recallradar

# Redis Cache & Celery Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API Configuration
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# NVIDIA NIM Configuration (Optional - Local deterministic fallback used if blank)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# External Public Data Source APIs (Optional)
CPSC_API_URL=https://www.saferproducts.gov/RestServices
SAFER_PRODUCTS_URL=https://www.saferproducts.gov/RestServices

# Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
