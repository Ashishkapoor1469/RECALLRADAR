<mxfile host="app.diagrams.net" modified="2026-09-28T22:00:00.000Z" agent="EarlyEcho Architecture Designer" version="24.0.0" type="device">
  <diagram id="earlyecho-arch" name="EarlyEcho Architecture &amp; Dataflow">
    <mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" background="#090D16" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Header -->
        <mxCell id="hdr" value="EARLYECHO (RECALLRADAR) SYSTEM ARCHITECTURE &amp; DATAFLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;fontColor=#F8FAFC;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1480" height="60" as="geometry" />
        </mxCell>
        <!-- Client -->
        <mxCell id="client" value="Client Frontend (Next.js 14)&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;apps/web (Dashboard)&lt;br&gt;apps/web2 (Review Portal)&lt;br&gt;Vercel Edge Network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#38BDF8;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="240" height="460" as="geometry" />
        </mxCell>
        <!-- API Gateway -->
        <mxCell id="gw" value="API Gateway / Edge Proxy&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;Route Proxy (/api/v1/*)&lt;br&gt;CORS &amp; Headers&lt;br&gt;Render Cloud&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#94A3B8;strokeWidth=2;dashed=1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="150" height="460" as="geometry" />
        </mxCell>
        <!-- FastAPI -->
        <mxCell id="fastapi" value="FastAPI Core Engine&lt;br&gt;&lt;font color=&quot;#2dd4bf&quot;&gt;Python 3.11 • Async ASGI&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;REST Surveillance Endpoints&lt;br&gt;Live /system/changes (&amp;lt;50ms)&lt;br&gt;Review Normalization&lt;br&gt;Bayesian Risk Engine&lt;br&gt;Resend &amp; Webhook Alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#009688;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="240" width="240" height="200" as="geometry" />
        </mxCell>
        <!-- ML Model -->
        <mxCell id="ml" value="ML Model (Product Evidence)&lt;br&gt;&lt;font color=&quot;#a78bfa&quot;&gt;Bayesian Defect Severity Scorer&lt;br&gt;14-Day Defect Spike Detector&lt;br&gt;Multi-Layer Regex &amp; Lexicon&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#A78BFA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="240" height="100" as="geometry" />
        </mxCell>
        <!-- RAG -->
        <mxCell id="rag" value="RAG (Ask EarlyEcho)&lt;br&gt;&lt;font color=&quot;#34d399&quot;&gt;NVIDIA NIM LLM Engine&lt;br&gt;Review ID Grounded Citations&lt;br&gt;Hallucination Refusal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="220" height="100" as="geometry" />
        </mxCell>
        <!-- Redis -->
        <mxCell id="redis" value="Redis (5min Cache)&lt;br&gt;&lt;font color=&quot;#f87171&quot;&gt;Upstash Redis Broker&lt;br&gt;Overview Aggregates Cache&lt;br&gt;Celery Async Task Queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#EF4444;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="280" width="220" height="100" as="geometry" />
        </mxCell>
        <!-- PostgreSQL -->
        <mxCell id="db" value="PostgreSQL (pgvector)&lt;br&gt;&lt;font color=&quot;#60a5fa&quot;&gt;Supabase AWS Cloud&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;products (187 models)&lt;br&gt;reviews (4,000+ records, 384d)&lt;br&gt;safety_signals (defect phrases)&lt;br&gt;alerts &amp; rules&lt;br&gt;audit_log&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#0E1626;strokeColor=#336791;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1140" y="160" width="240" height="270" as="geometry" />
        </mxCell>
        <!-- Organization DB -->
        <mxCell id="orgdb" value="Organization DB &amp; Ingestion Feeds&lt;br&gt;&lt;font color=&quot;#fbbf24&quot;&gt;Amazon Reviews CSV • CPSC Regulatory Recalls • Customer Support Tickets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="530" y="480" width="280" height="90" as="geometry" />
        </mxCell>
        <!-- Functional Requirements -->
        <mxCell id="f_req" value="Functional Requirements&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;1. Ingest Feedback &amp; Normalization (Amazon, CPSC, Support Tickets, dedupe)&lt;br&gt;2. Multi-Layer Defect Signal Detection &amp; Spike Engine (Regex + 14d defect frequency spike)&lt;br&gt;3. Prioritized Risk Queue (Bayesian harm score 0-100, lead-time warning)&lt;br&gt;4. RAG Grounded Copilot (NVIDIA NIM, review ID citations, refusal of unverified claims)&lt;br&gt;5. Multi-Channel Alerts (Resend transactional email, Slack webhook alerts)&lt;br&gt;6. Zero-Flicker Live Sync (/system/changes polling every 4.5s with preserved view state)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#38BDF8;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="720" height="440" as="geometry" />
        </mxCell>
        <!-- Non-Functional Requirements -->
        <mxCell id="nf_req" value="Non-Functional Requirements&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;1. Sub-50ms API Latency (&amp;lt;1ms in-memory cache on change tokens, 2.0s TTL)&lt;br&gt;2. Fail-Soft Network Isolation (5s timeout on outbound webhooks/emails/LLM)&lt;br&gt;3. Zero Temporal Leakage (Strict chronological cutoff prevents data contamination)&lt;br&gt;4. Single-Tab Polling Efficiency (1 loop per tab, pauses when tab hidden, &amp;lt;3.0 KB/min)&lt;br&gt;5. Exponential Backoff (Backs off to 30s on server downtime, auto-reconnects)&lt;br&gt;6. Enterprise Security &amp; Audit Trail (Zero committed secrets, append-only audit_log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1626;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="620" width="720" height="440" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E2E8F0;strokeWidth=2;fontColor=#94A3B8;fontSize=10;" edge="1" source="client" target="gw" parent="1">
