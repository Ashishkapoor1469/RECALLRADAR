<mxfile host="app.diagrams.net" modified="2026-09-28T22:20:00.000Z" agent="EarlyEcho Architecture Designer" version="24.0.0" type="device">
  <diagram id="earlyecho-arch" name="EarlyEcho Architecture &amp; Dataflow">
    <mxGraphModel dx="1600" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1140" background="#111113" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="hdr" value="EARLYECHO (RECALLRADAR) - SYSTEM ARCHITECTURE &amp; DATAFLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="22" width="1480" height="60" as="geometry" />
        </mxCell>
        
        <!-- Client -->
        <mxCell id="client" value="client&lt;br&gt;&lt;font color=&quot;#A1A1AA&quot; size=&quot;2&quot;&gt;NEXT.JS 14 APP ROUTER&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;apps/web (Dashboard)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;Overview • Risk Queue • Product Detail&lt;br&gt;Alerts • useLiveData Live Sync&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;apps/web2 (Review Portal)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;Live Customer Submission UI&lt;br&gt;Instant Defect Ingestion&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#71717A&quot;&gt;Vercel Edge Network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="250" height="475" as="geometry" />
        </mxCell>
        
        <!-- API Gateway -->
        <mxCell id="gw" value="api gateway&lt;br&gt;&lt;font color=&quot;#A1A1AA&quot;&gt;eg. routing, ratelimiting&lt;br&gt;load balance&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;Route Proxy (/api/v1/*)&lt;br&gt;CORS &amp; SSL Termination&lt;br&gt;Change Token Passthrough&lt;br&gt;&lt;br&gt;&lt;b&gt;Render Cloud Uvicorn ASGI&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;dashed=1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="355" y="105" width="145" height="475" as="geometry" />
        </mxCell>
        
        <!-- FastAPI Core Engine -->
        <mxCell id="fastapi" value="fastapi&lt;br&gt;&lt;font color=&quot;#34D399&quot;&gt;PYTHON 3.11 • ASYNC ASGI&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;Surveillance REST Endpoints&lt;br&gt;Live /system/changes (&amp;lt;50ms)&lt;br&gt;Review Normalizer &amp; Ingestion&lt;br&gt;Bayesian Risk Orchestrator&lt;br&gt;Resend Email &amp; Slack Webhooks&lt;br&gt;In-Memory Change Cache (2.0s)&lt;br&gt;Audit Governance Ledger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="235" width="250" height="215" as="geometry" />
        </mxCell>
        
        <!-- ML Model -->
        <mxCell id="ml" value="ML model for product evidence&lt;br&gt;&lt;font color=&quot;#C084FC&quot;&gt;Bayesian Defect Severity (0-100)&lt;br&gt;14-Day Velocity Spike Detector&lt;br&gt;Lexicon Safety Classifier &amp; Regex&lt;br&gt;Zero Temporal Leakage Chronology&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="545" y="95" width="250" height="115" as="geometry" />
        </mxCell>
        
        <!-- RAG -->
        <mxCell id="rag" value="RAG&lt;br&gt;&lt;font color=&quot;#A1A1AA&quot;&gt;- seraching similarities in reviews -&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#34D399&quot;&gt;NVIDIA NIM LLM Engine&lt;br&gt;pgvector Cosine Retrieval&lt;br&gt;Strict Review ID Citations [R-EXT-*]&lt;br&gt;Hallucination Refusal Guardrail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="835" y="95" width="230" height="115" as="geometry" />
        </mxCell>
        
        <!-- Redis -->
        <mxCell id="redis" value="redis 5min&lt;br&gt;&lt;font color=&quot;#F87171&quot;&gt;save expensive operation&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;In-Memory Change Cache (&amp;lt;1ms)&lt;br&gt;5-Min TTL Overview Cache&lt;br&gt;Celery Task Broker Queue&lt;br&gt;Fail-Soft In-Process Fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="835" y="275" width="230" height="110" as="geometry" />
        </mxCell>
        
        <!-- Database PostgreSQL -->
        <mxCell id="db" value="Database postgress sql&lt;br&gt;(pg vector)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#60A5FA&quot;&gt;Supabase AWS Cloud PG15&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;products (187 models)&lt;br&gt;reviews (4,062 items, 384d)&lt;br&gt;safety_signals (hazard phrases)&lt;br&gt;product_risk_snapshots&lt;br&gt;alerts &amp; alert_rules&lt;br&gt;audit_log ledger&lt;br&gt;IVFFlat Similarity Index&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1120" y="135" width="270" height="315" as="geometry" />
        </mxCell>
        
        <!-- Organization DB -->
        <mxCell id="orgdb" value="ORGANIZATION DB&lt;br&gt;&lt;font color=&quot;#FBBF24&quot;&gt;ADAPTERS &amp; MULTI-SOURCE INGESTION&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;Amazon Reviews CSV (4,000+ items)&lt;br&gt;CPSC SaferProducts Gov Recall Feed&lt;br&gt;Support Tickets CSV / Dedup CLI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="525" y="480" width="290" height="110" as="geometry" />
        </mxCell>
        
        <!-- Functional Requirements -->
        <mxCell id="f_req" value="Functinal requirenment&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Ingest feedback&lt;/b&gt;&lt;br&gt;Loads reviews by CSV or adapters (db adapters connect to any db), normalize them into one schema and dedupe them with SHA-256 fingerprinting.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Detects defect signals &amp; velocity spikes&lt;/b&gt;&lt;br&gt;Multi-layer regex &amp; safety taxonomy for critical hazard terms (burn, spark, fire, explosion) plus 14-day defect frequency spike detector.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Prioritizes risk queue &amp; lead-time warning&lt;/b&gt;&lt;br&gt;Bayesian hazard severity scoring (0-100 scale) prioritizing dangerous anomalies and predicting recall hazard windows 4-12 weeks before regulator action.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; RAG root-cause assistant (Ask EarlyEcho)&lt;/b&gt;&lt;br&gt;NVIDIA NIM LLM generates grounded answers strictly citing retrieved review IDs [R-EXT-*] with refusal of ungrounded speculation.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Multi-channel alert engine &amp; directives&lt;/b&gt;&lt;br&gt;Compiles natural language rules into temporal directives; dispatches real transactional emails via Resend API and Slack webhooks.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Live zero-flicker dashboard synchronization (/system/changes)&lt;/b&gt;&lt;br&gt;Unified useLiveData hook polls composite change token every 4.5s; updates Overview, Risk Queue, Alerts without manual page reload.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="720" height="480" as="geometry" />
        </mxCell>
        
        <!-- Non-Functional Requirements -->
        <mxCell id="nf_req" value="Non-Functinal requirenment&lt;br&gt;&lt;font color=&quot;#D4D4D8&quot;&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Sub-50ms latency &amp; in-memory change token&lt;/b&gt;&lt;br&gt;GET /api/v1/system/changes resolves in &amp;lt;1ms from in-memory cache (2.0s TTL), bypassing database roundtrips on cache hits.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Fail-soft network isolation &amp; graceful degradation&lt;/b&gt;&lt;br&gt;Strict 5-second timeout on all outbound network calls (Resend, Slack, NVIDIA NIM LLM). Outbound timeouts fail soft without crashing pipelines.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Zero temporal leakage &amp; chronological integrity&lt;/b&gt;&lt;br&gt;Backtesting and lead-time simulations strictly mask all reviews after the simulation date, preventing future data contamination.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Single-tab polling efficiency &amp; visibility pausing&lt;/b&gt;&lt;br&gt;Single polling loop per browser tab; consumes only 230 bytes per poll (~3.0 KB/min). Pauses immediately when tab is hidden (Page Visibility API).&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Exponential backoff &amp; connection resilience&lt;/b&gt;&lt;br&gt;On network failures, polling interval backs off gracefully (4.5s -&amp;gt; 8s -&amp;gt; 14.5s -&amp;gt; 26s -&amp;gt; 30s max); dashboard shows 'Reconnecting…'.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;gt; Enterprise security &amp; audit governance&lt;/b&gt;&lt;br&gt;Zero hardcoded secrets; environment-driven credentials; append-only audit_log table records all rule creations, exports, and alerts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181C;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="620" width="720" height="480" as="geometry" />
        </mxCell>
        
        <!-- Edges in Clean White Lines -->
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="client" target="gw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="PROXY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="gw" target="fastapi" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="DEFECT SCORING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="fastapi" target="ml" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="QUERY INTENT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="fastapi" target="rag" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="- seraching similarities in reviews -" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="rag" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="save expensive operation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="fastapi" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="redis" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="open api route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" source="orgdb" target="fastapi" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="INDEXED COUNT &amp; TOKENS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=10;" edge="1" source="db" target="fastapi" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1090" y="415" />
