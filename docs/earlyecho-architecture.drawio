        <mxCell id="ingest_dedup" value="&lt;b&gt;DeduplicationManager&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Entity Resolution &amp;amp; Fuzzy Match&lt;br/&gt;• Hash Check: reviewerID + timestamp&lt;br/&gt;• Product Linking &amp;amp; Auto-Creation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_ingestion">
