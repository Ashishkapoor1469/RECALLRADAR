        </mxCell>
        <mxCell id="ingest_cli" value="&lt;b&gt;CLI Ingestion Scripts&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;`ingest_amazon_csv.py` • `ingest_support_tickets_csv.py`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;fontColor=#CBD5E1;fontSize=10;" vertex="1" parent="box_ingestion">
          <mxGeometry x="15" y="340" width="250" height="50" as="geometry"/>
        </mxCell>

        <!-- 3. FASTAPI BACKEND GATEWAY -->
        <mxCell id="box_api" value="3. FASTAPI REST API (Render Deployment: recallradar-api-upim)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#10B981;fontColor=#10B981;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="690" y="120" width="310" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="api_routers" value="&lt;b&gt;Modular Endpoint Routers (`/api/v1/`)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;• &lt;b&gt;/overview&lt;/b&gt;: Summary counts, KPIs, Sentiment&lt;br/&gt;• &lt;b&gt;/risk-queue&lt;/b&gt;: Server-side Paginated Queue&lt;br/&gt;• &lt;b&gt;/products&lt;/b&gt;: Deep-dive, Timeline, Citations&lt;br/&gt;• &lt;b&gt;/reviews/submit&lt;/b&gt;: Direct Ingestion &amp;amp; Recalc&lt;br/&gt;• &lt;b&gt;/alerts&lt;/b&gt;: Natural Language Rules &amp;amp; Dispatch&lt;br/&gt;• &lt;b&gt;/backtests&lt;/b&gt;: Lead-time Simulation &amp;amp; CSV Export&lt;br/&gt;• &lt;b&gt;/chat&lt;/b&gt;: SQL Grounded &amp;amp; Generative AI Copilot&lt;br/&gt;• &lt;b&gt;/data-quality&lt;/b&gt;: Live Health &amp;amp; Vector Probes&lt;br/&gt;• &lt;b&gt;/system/status&lt;/b&gt;: Dialect &amp;amp; DB Telemetry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_api">
          <mxGeometry x="15" y="45" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="api_audit" value="&lt;b&gt;Append-Only Audit Logger (`audit_log`)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Logs RULE_CREATE, ALERT_DISPATCH, DATA_EXPORT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#8B5CF6;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="box_api">
          <mxGeometry x="15" y="250" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="api_cors" value="&lt;b&gt;Security &amp;amp; Middleware&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Dynamic CORS Middleware • Pydantic V2 Validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;fontColor=#CBD5E1;fontSize=10;" vertex="1" parent="box_api">
          <mxGeometry x="15" y="320" width="280" height="45" as="geometry"/>
        </mxCell>

        <!-- 4. ML DETECTION & RISK SCORING -->
        <mxCell id="box_ml" value="4. ML DEFECT DETECTION &amp;amp; RISK ENGINES" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#EC4899;fontColor=#EC4899;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1030" y="120" width="260" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="ml_detector" value="&lt;b&gt;SafetySignalDetector&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Multi-layer Lexicon Detection&lt;br/&gt;Fire, Burn, Smoke, Shock, Injury&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EC4899;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ml">
          <mxGeometry x="15" y="45" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ml_context" value="&lt;b&gt;Context Disambiguation&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;`is_false_positive_context`&lt;br/&gt;Suppresses 'fire deal', 'audio bleed'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EC4899;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ml">
          <mxGeometry x="15" y="115" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ml_risk" value="&lt;b&gt;InterpretableRiskEngine&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;0–100 Bayesian Risk Score&lt;br/&gt;Density, Severity, Temporal Velocity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EC4899;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ml">
          <mxGeometry x="15" y="185" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ml_embed" value="&lt;b&gt;EmbeddingGenerator&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;SentenceTransformer 384-dim Vector&lt;br/&gt;Dense semantic vector encoder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#A855F7;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ml">
          <mxGeometry x="15" y="260" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ml_cluster" value="&lt;b&gt;HazardClusterer &amp;amp; Survival&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;DBSCAN Clustering &amp;amp; Lead Time Est.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EC4899;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="box_ml">
          <mxGeometry x="15" y="330" width="230" height="45" as="geometry"/>
        </mxCell>

        <!-- 5. STORAGE & DISPATCH INFRASTRUCTURE -->
        <mxCell id="box_infra" value="5. DATA PERSISTENCE &amp;amp; EXTERNAL INFRASTRUCTURE" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#6366F1;fontColor=#6366F1;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="120" width="240" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="infra_pg" value="&lt;b&gt;PostgreSQL 16 + pgvector&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Hosted on Supabase (Port 6543)&lt;br/&gt;• products, reviews, recalls&lt;br/&gt;• safety_signals, review_signals&lt;br/&gt;• product_risk_snapshots&lt;br/&gt;• alerts, alert_rules, audit_log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="box_infra">
          <mxGeometry x="15" y="45" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="infra_resend" value="&lt;b&gt;Resend Email Dispatcher&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Transactional Incident Emails&lt;br/&gt;Live API + Sandbox Fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_infra">
          <mxGeometry x="15" y="170" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="infra_webhook" value="&lt;b&gt;Slack Webhook Channel&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Posts to ALERT_WEBHOOK_URL&lt;br/&gt;5s Timeout • Fail-Soft Isolated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#06B6D4;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_infra">
          <mxGeometry x="15" y="240" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="infra_celery" value="&lt;b&gt;Celery Workers &amp;amp; Redis Broker&lt;/b&gt;&lt;br/&gt;&lt;font color='#F87171' style='font-size: 9px;'&gt;[Dashed: Worker Daemon Offline]&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Upstash Redis Broker Connected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EF4444;strokeWidth=1;dashed=1;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="box_infra">
          <mxGeometry x="15" y="310" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="infra_nim" value="&lt;b&gt;NVIDIA NIM AI API&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Llama-3.2-11b-vision-instruct&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#84CC16;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="box_infra">
          <mxGeometry x="15" y="375" width="210" height="35" as="geometry"/>
        </mxCell>

        <!-- ========================================== -->
        <!-- MIDDLE SECTION: NUMBERED WORKFLOW PIPELINE -->
        <!-- ========================================== -->
        <mxCell id="flow_banner" value="&lt;font color='#38BDF8' style='font-size: 14px; font-weight: 800;'&gt;END-TO-END DATA PROCESSING &amp;amp; SURVEILLANCE WORKFLOW (STEPS 1 – 11)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;fontColor=#F8FAFC;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1520" height="35" as="geometry"/>
        </mxCell>

        <!-- Workflow Step Nodes -->
        <mxCell id="step1" value="&lt;b&gt;1. Review Submitted&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Web 2 / CSV / Tickets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;2. Dedup &amp;amp; Normalize&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Adapter + DedupManager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F59E0B;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;3. Persist to DB&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Review record saved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#6366F1;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;4. Signal Detection&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Lexicon + Context Check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#EC4899;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;5. Embeddings Gen&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Vectorized for pgvector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#A855F7;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step6" value="&lt;b&gt;6. Risk Score Recalc&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Risk snapshot 0–100&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#EC4899;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step7" value="&lt;b&gt;7. UI Live Update&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Dashboard polls &amp;amp; syncs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step8" value="&lt;b&gt;8. Rule Evaluation&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Threshold &amp;amp; Spike Engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F59E0B;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step9" value="&lt;b&gt;9. Alert Dispatched&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Resend Email + Slack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#10B981;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step10" value="&lt;b&gt;10. Analyst Chat Q&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Query submitted in `/ask`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="615" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step11" value="&lt;b&gt;11. Grounded RAG&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 9px;'&gt;Citations + Table/LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#84CC16;fontColor=#F8FAFC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="615" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Connecting workflow arrows -->
        <mxCell id="w1" edge="1" source="step1" target="step2" parent="1" style="strokeColor=#38BDF8;strokeWidth=2;"/>
        <mxCell id="w2" edge="1" source="step2" target="step3" parent="1" style="strokeColor=#F59E0B;strokeWidth=2;"/>
        <mxCell id="w3" edge="1" source="step3" target="step4" parent="1" style="strokeColor=#6366F1;strokeWidth=2;"/>
        <mxCell id="w4" edge="1" source="step4" target="step5" parent="1" style="strokeColor=#EC4899;strokeWidth=2;"/>
        <mxCell id="w5" edge="1" source="step5" target="step6" parent="1" style="strokeColor=#A855F7;strokeWidth=2;"/>
        <mxCell id="w6" edge="1" source="step6" target="step7" parent="1" style="strokeColor=#EC4899;strokeWidth=2;"/>
        <mxCell id="w7" edge="1" source="step6" target="step8" parent="1" style="strokeColor=#F59E0B;strokeWidth=2;"/>
        <mxCell id="w8" edge="1" source="step8" target="step9" parent="1" style="strokeColor=#10B981;strokeWidth=2;"/>
