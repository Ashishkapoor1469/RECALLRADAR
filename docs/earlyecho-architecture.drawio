  <diagram id="earlyecho-architecture" name="EarlyEcho Architecture &amp; Workflow">
    <mxGraphModel dx="1600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" background="#0F172A">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- MAIN TITLE BANNER -->
        <mxCell id="title_banner" value="&lt;font color='#F8FAFC' style='font-size: 24px; font-weight: 800;'&gt;EARLYECHO (RECALLRADAR) SYSTEM ARCHITECTURE &amp;amp; WORKFLOW PIPELINE&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 13px;'&gt;Continuous Multi-Source Feedback Surveillance • Bayesian Defect Scoring • pgvector Grounded Intelligence • Incident Early Warning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;shadow=1;arcSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="70" as="geometry"/>
        </mxCell>

        <!-- ========================================== -->
        <!-- TOP SECTION: ARCHITECTURAL BOUNDARIES      -->
        <!-- ========================================== -->

        <!-- 1. USERS & CLIENTS LAYER -->
        <mxCell id="box_clients" value="1. USERS &amp;amp; CLIENT INTERFACES (Vercel Deployment)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="310" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="client_analyst" value="&lt;b&gt;Safety Analyst&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8'&gt;Desktop Browser&lt;/font&gt;" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_clients">
          <mxGeometry x="25" y="45" width="55" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="client_qa" value="&lt;b&gt;QA / Customer&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8'&gt;Feedback Submitter&lt;/font&gt;" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F43F5E;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_clients">
          <mxGeometry x="220" y="45" width="55" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="web1_dashboard" value="&lt;b&gt;Main Dashboard (apps/web)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Next.js 14 App Router • Tailwind CSS&lt;br/&gt;• Executive Overview (`/`)&lt;br/&gt;• Risk Queue (`/risk-queue`)&lt;br/&gt;• Product Investigation (`/products/[id]`)&lt;br/&gt;• Backtest Lab (`/backtest`)&lt;br/&gt;• Telemetry Quality (`/data-quality`)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0284C7;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_clients">
          <mxGeometry x="20" y="130" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="web2_portal" value="&lt;b&gt;Customer Review Portal (apps/web2)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Next.js 14 Direct DB Submitter&lt;br/&gt;• Interactive Review Writer&lt;br/&gt;• Presets: Fire Hazard, Shock, Positive&lt;br/&gt;• Real-time Ticker Feed (3.5s Poll)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#E11D48;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_clients">
          <mxGeometry x="20" y="280" width="270" height="110" as="geometry"/>
        </mxCell>

        <!-- 2. INGESTION & NORMALIZATION -->
        <mxCell id="box_ingestion" value="2. UNIFIED INGESTION LAYER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F59E0B;fontColor=#F59E0B;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="280" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="adapter_amz" value="&lt;b&gt;AmazonReviewsAdapter&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Marketplace CSV 2023 Parser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ingestion">
          <mxGeometry x="15" y="45" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="adapter_ticket" value="&lt;b&gt;SupportTicketsAdapter&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;Generic Support Tickets Ingestion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ingestion">
          <mxGeometry x="15" y="105" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="adapter_cpsc" value="&lt;b&gt;CPSC / SaferProducts Adapter&lt;/b&gt;&lt;br/&gt;&lt;font color='#F87171' style='font-size: 9px;'&gt;[Dashed: Polling Not Connected Live]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EF4444;strokeWidth=1;dashed=1;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_ingestion">
          <mxGeometry x="15" y="165" width="250" height="45" as="geometry"/>
